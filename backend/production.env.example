# VoxShield production configuration
# Copy these values into the deployment environment. Never commit real secrets.

VOXSHIELD_API_KEY=replace-with-a-long-random-secret
# Local dev: both Vite default port AND our configured port 3000
VOXSHIELD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VOXSHIELD_MAX_UPLOAD_MB=25
VOXSHIELD_MAX_CONCURRENT_INFERENCES=2
VOXSHIELD_EXPOSE_PATHS=false
VOXSHIELD_API_VERSION=1.1.0
